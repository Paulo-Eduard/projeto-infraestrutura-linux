# Configurações da Aplicação
APP_NAME="InfraLab Web API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Configurações de Rede Interna (Uvicorn)
HOST="127.0.0.1"
PORT=8000

# Conexão com o Banco de Dados PostgreSQL (Luiz)
# Exemplo local SQLite fallback: sqlite:////tmp/infralab_dev.db
DATABASE_URL="postgresql://infralab_user:senha_segura@localhost:5432/infralab_db"

# Segurança e Origens CORS
ALLOWED_ORIGINS="*"
