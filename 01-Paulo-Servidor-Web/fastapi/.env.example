# Copie para .env (cp .env.example .env) e ajuste os valores.
# Este arquivo e lido pelo systemd (EnvironmentFile=) e, como fallback para
# execucao manual/dev, pelo proprio app via python-dotenv.
# Nao use "export" nem espacos ao redor do "=".

# --- Aplicacao ---
APP_NAME="InfraLab Web API"
APP_VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=False

# --- Rede interna (Uvicorn) ---
HOST=127.0.0.1
PORT=8000

# --- Banco de dados PostgreSQL (Luiz) ---
# Substitua SENHA pela senha ja CODIFICADA para URL. Caracteres especiais
# precisam ser codificados: @ -> %40   # -> %23   ! -> %21   : -> %3A   / -> %2F   % -> %25
# Para gerar a senha codificada:
#   python3 -c "import urllib.parse,getpass; print(urllib.parse.quote(getpass.getpass(), safe=''))"
# Nao coloque aspas nesta linha.
DATABASE_URL=postgresql+psycopg2://infralab_user:SENHA@192.168.30.10:5432/infralab_db

# Alternativa apenas para DESENVOLVIMENTO LOCAL (com ENVIRONMENT=development):
# DATABASE_URL=sqlite:////tmp/infralab_dev.db

# --- Seguranca e origens CORS (separe por virgula; "*" libera todas) ---
ALLOWED_ORIGINS="*"
